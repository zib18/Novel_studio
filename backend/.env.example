# Only the server reads this file. Copy to backend/.env; do not commit .env.
# SQLite default: backend/data/novel.db. For PostgreSQL:
# NOVEL_DATABASE_URL=postgresql+psycopg://novel:password@localhost:5432/novel
NOVEL_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5173"]
NOVEL_COOKIE_SECURE=false
NOVEL_OPENAI_API_KEY=
NOVEL_OPENAI_MODEL=gpt-4.1-mini
NOVEL_AI_JOB_BUDGET_USD=1.0
NOVEL_AI_DAILY_BUDGET_USD=5.0
NOVEL_AI_MAX_CALLS=20
NOVEL_AI_CONTEXT_CHARS=40000
NOVEL_AI_MAX_OUTPUT_TOKENS=4500
NOVEL_AI_TIMEOUT_SECONDS=120
# Approximate prices: update according to your provider account.
NOVEL_AI_INPUT_USD_PER_MILLION=0.4
NOVEL_AI_OUTPUT_USD_PER_MILLION=1.6
